<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#329F9A">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="TAFWITA">

  <title>TAFWITA — Patient</title>

  <link rel="manifest" href="./manifest.webmanifest">
  <link rel="apple-touch-icon" href="./icon-192.png">

  
<style>
/* =========================================================
   TAFWITA — Mobile-first UI
   ========================================================= */

:root {
  --bg: #f5f8f8;
  --surface: #ffffff;
  --surface-soft: #f3faf8;
  --border: #dbeae7;
  --primary: #329f9a;
  --primary-dark: #237873;
  --text: #28373e;
  --muted: #607078;
  --subtle: #9baab0;
  --success: #2c8b69;
  --warning: #a97524;
  --danger: #bc5d62;
  --shadow-sm: 0 5px 16px rgba(31, 92, 85, .06);
  --shadow: 0 12px 30px rgba(31, 92, 85, .09);
  --radius-sm: 12px;
  --radius: 16px;
  --radius-lg: 20px;
  --nav-height: 68px;
  --safe-bottom: env(safe-area-inset-bottom, 0px);
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  font-size: 16px;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100dvh;
  overflow-x: hidden;
  background:
    linear-gradient(145deg, #edf8f6 0%, var(--bg) 45%, #ffffff 100%);
  color: var(--text);
  font: 16px/1.45 "Segoe UI", Arial, sans-serif;
  -webkit-tap-highlight-color: transparent;
}

button,
input {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

button:focus-visible,
input:focus-visible {
  outline: 3px solid rgba(50, 159, 154, .25);
  outline-offset: 2px;
}

[hidden] {
  display: none !important;
}

/* ---------- App shell ---------- */

.shell {
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  padding:
    max(16px, env(safe-area-inset-top))
    16px
    calc(var(--nav-height) + 34px + var(--safe-bottom));
}

/* ---------- Header ---------- */

.top {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 24px;
}

.top > div:first-child {
  min-width: 0;
}

.logo {
  font-size: 30px;
  line-height: 1;
  font-weight: 900;
  letter-spacing: .4px;
}

.logo span {
  color: var(--primary);
}

.sub {
  margin: 7px 0 0;
  color: var(--subtle);
  font-size: 14px;
}

.tools {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 8px;
  width: 100%;
}

.tool,
.link,
.back {
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--primary-dark);
  font-weight: 800;
  cursor: pointer;
  touch-action: manipulation;
}

.tool {
  min-height: 50px;
  padding: 0 12px;
  border-radius: var(--radius-sm);
}

.tool:hover,
.link:hover,
.back:hover {
  border-color: #bfe8df;
  background: var(--surface-soft);
}

/* ---------- Views ---------- */

.view {
  display: none;
  animation: viewIn .18s ease;
}

.view.active {
  display: block;
}

@keyframes viewIn {
  from {
    opacity: 0;
    transform: translateY(5px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

h1,
h2,
h3,
p {
  overflow-wrap: anywhere;
}

h1 {
  margin: 0 0 8px;
  font-size: 30px;
  line-height: 1.15;
}

h2 {
  margin: 0;
  font-size: 22px;
  line-height: 1.25;
}

.lead {
  margin: 0 0 20px;
  color: var(--muted);
  font-size: 16px;
  line-height: 1.55;
}

/* ---------- Cards / lists ---------- */

.card {
  padding: 18px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
}

.list {
  display: grid;
  gap: 12px;
}

.doctor,
.ticket-row {
  display: flex;
  align-items: center;
  gap: 13px;
  min-width: 0;
  min-height: 92px;
  padding: 15px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  cursor: pointer;
  touch-action: manipulation;
}

.doctor:hover,
.ticket-row:hover {
  background: var(--surface-soft);
  border-color: #bfe8df;
}

.avatar,
.bubble {
  display: grid;
  place-items: center;
  width: 58px;
  height: 58px;
  flex: 0 0 58px;
  border-radius: 16px;
  background: #ddf2ee;
  color: var(--primary-dark);
  font-size: 19px;
  font-weight: 900;
}

.main {
  min-width: 0;
  flex: 1;
}

.main h3 {
  margin: 0 0 5px;
  font-size: 18px;
  line-height: 1.25;
}

.meta {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.35;
  white-space: normal;
}

.badge,
.status {
  display: inline-block;
  max-width: 100%;
  margin-top: 8px;
  padding: 6px 9px;
  border-radius: 999px;
  background: #e4f5ee;
  color: var(--success);
  font-size: 13px;
  line-height: 1.2;
  font-weight: 800;
}

.status.suspended,
.status.urgent {
  background: #fff4de;
  color: var(--warning);
}

.status.cancelled {
  background: #fceced;
  color: var(--danger);
}

.status.serving {
  background: #e4f5ee;
  color: var(--success);
}

.status.completed {
  background: #edf0f0;
  color: var(--muted);
}

.star {
  flex: 0 0 auto;
  width: 46px;
  height: 46px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #b2bec2;
  font-size: 29px;
  line-height: 1;
  cursor: pointer;
  touch-action: manipulation;
}

.star.active {
  color: #d39a27;
}

.empty {
  padding: 26px 18px;
  border: 1px dashed #bcded7;
  border-radius: var(--radius);
  background: var(--surface);
  text-align: center;
  color: var(--muted);
}

/* ---------- Inputs ---------- */

.search,
.input {
  display: block;
  width: 100%;
  min-height: 54px;
  padding: 0 15px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--surface);
  color: var(--text);
  font: inherit;
  font-size: 16px;
  outline: 0;
}

.search:focus,
.input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 4px rgba(50, 159, 154, .12);
}

label {
  display: block;
  margin-bottom: 7px;
  font-weight: 700;
}

/* ---------- Section heads ---------- */

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 25px 0 13px;
}

.link {
  min-height: 42px;
  padding: 7px 12px;
  border-radius: 10px;
}

.topline {
  display: grid;
  grid-template-columns: 44px 1fr;
  align-items: center;
  gap: 10px;
  margin-bottom: 17px;
}

.back {
  width: 44px;
  height: 44px;
  padding: 0;
  border-radius: 50%;
  font-size: 25px;
  line-height: 1;
}

/* ---------- Cabinet details ---------- */

.profile {
  display: flex;
  align-items: center;
  gap: 13px;
  min-width: 0;
}

.big-avatar {
  display: grid;
  place-items: center;
  width: 68px;
  height: 68px;
  flex: 0 0 68px;
  border-radius: 19px;
  background: #ddf2ee;
  color: var(--primary-dark);
  font-size: 22px;
  font-weight: 900;
}

.profile > div:nth-child(2) {
  min-width: 0;
  flex: 1;
}

.profile h2 {
  margin: 0 0 4px;
  font-size: 21px;
}

.profile p {
  margin: 0;
  color: var(--primary-dark);
  font-weight: 700;
  font-size: 14px;
}

.details {
  display: grid;
  gap: 9px;
  margin: 18px 0;
}

.detail {
  padding: 13px;
  border-radius: 13px;
  background: var(--surface-soft);
  color: var(--muted);
  font-size: 15px;
}

.detail small {
  display: block;
  margin-bottom: 3px;
  color: var(--subtle);
  font-size: 13px;
}

.primary {
  width: 100%;
  min-height: 56px;
  border: 0;
  border-radius: 15px;
  background: linear-gradient(90deg, var(--primary), #55bcb2);
  color: #fff;
  font-weight: 800;
  font-size: 17px;
  cursor: pointer;
  box-shadow: 0 9px 20px rgba(50, 159, 154, .22);
  touch-action: manipulation;
}

.primary:disabled {
  opacity: .55;
  cursor: not-allowed;
}

.message {
  min-height: 20px;
  margin: 10px 0 0;
  color: var(--danger);
  text-align: center;
  font-size: 13px;
}

/* ---------- Ticket ---------- */

.ticket {
  text-align: center;
}

.check {
  display: grid;
  place-items: center;
  width: 58px;
  height: 58px;
  margin: 0 auto;
  border-radius: 50%;
  background: #e4f5ee;
  color: var(--success);
  font-size: 28px;
  font-weight: 900;
}

.number {
  margin: 18px 0;
  padding: 20px;
  border: 1px solid #bfe8df;
  border-radius: 18px;
  background: #ddf2ee;
}

.number small {
  display: block;
  color: var(--muted);
  font-size: 13px;
}

.number strong {
  display: block;
  margin-top: 2px;
  color: var(--primary-dark);
  font-size: clamp(44px, 15vw, 64px);
  line-height: 1;
}

.notice {
  margin: 12px 0;
  padding: 14px;
  border-radius: 13px;
  background: var(--surface-soft);
  color: var(--muted);
  font-size: 15px;
  line-height: 1.5;
}

.notice.warn {
  background: #fff4de;
  color: #755714;
}

.notice.danger {
  background: #fceced;
  color: #963c43;
}

.progress {
  height: 9px;
  margin: 14px 0;
  overflow: hidden;
  border-radius: 999px;
  background: var(--border);
}

.progress div {
  width: 5%;
  height: 100%;
  background: var(--primary);
  transition: width .5s ease;
}

.actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 9px;
  margin-top: 14px;
}

.action {
  width: 100%;
  min-height: 54px;
  padding: 10px 12px;
  border: 1px solid var(--border);
  border-radius: 13px;
  background: var(--surface);
  color: var(--muted);
  font-weight: 800;
  cursor: pointer;
  touch-action: manipulation;
}

.action.orange {
  background: #fffaf0;
  color: var(--warning);
  border-color: #f2d9a5;
}

.action.red {
  background: #fff7f7;
  color: var(--danger);
  border-color: #f0cfd2;
}

.timeline {
  display: grid;
  gap: 8px;
}

.event {
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--surface);
  text-align: left;
}

.event b {
  display: block;
  font-size: 13px;
}

.event span {
  color: var(--subtle);
  font-size: 12px;
}

/* ---------- Bottom navigation ---------- */

.bottom {
  position: fixed;
  z-index: 20;
  right: 10px;
  bottom: max(8px, var(--safe-bottom));
  left: 10px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4px;
  width: auto;
  max-width: 620px;
  margin: 0 auto;
  padding: 6px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: rgba(255, 255, 255, .96);
  box-shadow: 0 12px 30px rgba(31, 92, 85, .14);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.nav {
  min-height: 56px;
  border: 0;
  border-radius: 13px;
  background: transparent;
  color: var(--subtle);
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  touch-action: manipulation;
}

.nav.active {
  background: #ddf2ee;
  color: var(--primary-dark);
}

/* ---------- Toast ---------- */

.toast {
  position: fixed;
  z-index: 50;
  top: max(12px, env(safe-area-inset-top));
  left: 50%;
  max-width: calc(100% - 24px);
  padding: 12px 15px;
  border: 1px solid var(--border);
  border-radius: 13px;
  background: var(--surface);
  box-shadow: var(--shadow);
  color: var(--text);
  font-size: 14px;
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, -18px);
  transition: opacity .2s ease, transform .2s ease;
}

.toast.show {
  opacity: 1;
  transform: translate(-50%, 0);
}

/* ---------- Tablet / desktop ---------- */

@media (min-width: 650px) {
  .shell {
    padding: 24px 20px 110px;
  }

  .top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .tools {
    width: auto;
    grid-template-columns: repeat(3, auto);
  }

  .tool {
    min-width: 70px;
  }

  .list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .actions {
    grid-template-columns: repeat(3, 1fr);
  }

  .bottom {
    right: auto;
    left: 50%;
    width: min(calc(100% - 40px), 620px);
    transform: translateX(-50%);
  }
}

/* ---------- Large desktop ---------- */

@media (min-width: 900px) {
  .shell {
    padding-top: 30px;
  }

  h1 {
    font-size: 32px;
  }
}

/* ---------- Reduced motion ---------- */

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}
</style>

</head>
